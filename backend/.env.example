# Use a managed PostgreSQL database URL with SSL enabled for production.
# The API accepts postgres://, postgresql://, or postgresql+asyncpg:// URLs.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Generate a unique, high-entropy value for each deployed environment.
JWT_SECRET=replace-with-a-long-random-secret

# JSON array of exact allowed browser origins; update after frontend deployment.
CORS_ORIGINS=["http://localhost:3000"]